# syntax=docker/dockerfile:1
FROM node:20-alpine

WORKDIR /app

# Install packages with npm (avoids pnpm 9+ ERR_PNPM_IGNORED_BUILDS for esbuild)
COPY package.json ./
RUN npm install

COPY . .
EXPOSE 5173
# Use npm run dev — vite.config.ts already sets host:true and port:5173
CMD ["npm", "run", "dev"]
