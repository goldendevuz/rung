# ── Environment ──────────────────────────────────────────────────────────────
ENV=dev                              # dev | prod
TZ=Asia/Tashkent                     # Server time zone
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Ports (Dev only, managed by scripts/pick-ports.sh) ────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=rung                   # PostgreSQL username
POSTGRES_PASSWORD=                   # PostgreSQL password (fill in)
POSTGRES_DB=rung                     # PostgreSQL database name
DATABASE_URL=postgresql+asyncpg://rung:@postgres:5432/rung

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0       # Redis connection URL

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=                          # Random 64-char hex (fill in)
INTERNAL_API_TOKEN=                  # Token for bot → backend calls (fill in)

# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=                           # @BotFather token (fill in)
BOT_USERNAME=rung_uz_bot             # Bot username without @
ADMIN_TG_IDS=557407324               # Comma-separated Telegram user IDs

# ── URLs ───────────────────────────────────────────────────────────────────────
WEBAPP_URL=http://localhost           # Public URL of the web app (for bot buttons)
PUBLIC_BASE_URL=http://localhost     # Public base URL (VPS: http://<IP>)

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                    # Google OAuth client ID (fill in)
GOOGLE_CLIENT_SECRET=                # Google OAuth client secret (fill in)

# ── Dev / Testing ──────────────────────────────────────────────────────────────
DEV_AUTH=true                        # Enable /auth/dev-login; MUST be false in prod
SEED_DEMO=false                      # Seed demo data on startup

# ── Feature flags ──────────────────────────────────────────────────────────────
STARS_ENABLED=false
PAYNET_ENABLED=false
GOOGLE_AUTH_ENABLED=false                   # Telegram Stars top-up enabled
SHOW_PAYMENT_DETAILS=false           # Show provider/currency details in UI

# ── inPAY.uz ───────────────────────────────────────────────────────────────────
INPAY_MERCHANT_ID=                   # inPAY merchant ID
INPAY_MERCHANT_TOKEN=                # inPAY merchant token
INPAY_CALLBACK_URL=https://rung.shats.uz/api/v1/payments/inpay/callback
INPAY_RETURN_URL=https://rung.shats.uz/hamyon

# ── Listing kinds ──────────────────────────────────────────────────────────────
ENABLED_LISTING_KINDS=channel        # Comma-separated; only 'channel' in v1

# ── Money constants (seeded into settings table; admin-editable later) ─────────
B_UNIT_UZS=1000                      # 1 B = 1000 units = 1000 UZS (manual top-up)
STARS_UNITS_PER_STAR=200             # 1 Star = 200 units = 0.2 B
FLOOR_B=1                            # Minimum bid price in B
MIN_STEP_B=1                         # Minimum bid increment in B
MANUAL_MIN_UZS=1000                  # Minimum Paynet top-up in UZS
MANUAL_STEP_UZS=1000                 # Paynet top-up step in UZS (whole thousands)

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1            # Frontend API base URL
BOT_TOKEN_DEV=123
BOT_TOKEN=123

# Demo button shown in topbar (disable on final prod URL)
SHOW_DEMO_BUTTON=false

# Text shown next to the price on the hero and in claim sheet
PAYMENT_PROVIDER_TEXT=to'lov tez orada

# DataFast analytics server-side tracking API key (server-only, never sent to frontend)
DATAFAST_API_KEY=
