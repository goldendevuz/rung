{
    auto_https off
    servers {
        trusted_proxies static private_ranges
    }
}
:80 {
    encode gzip
    handle /healthz {
        reverse_proxy backend_prod:8000
    }
    @blocked_docs {
        path /docs* /redoc* /openapi* /api/v1/docs* /api/v1/redoc* /api/v1/openapi*
    }
    handle @blocked_docs {
        respond "Not Found" 404
    }
    @api {
        path /api/* /readyz /go/*
    }
    handle @api {
        reverse_proxy backend_prod:8000
    }
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
