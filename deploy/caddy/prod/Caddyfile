{
    auto_https off
    servers {
        trusted_proxies static private_ranges
    }
}
:80 {
    encode gzip
    handle /healthz {
        reverse_proxy backend_prod:8000
    }
    @api {
        path /api/* /readyz /go/*
    }
    handle @api {
        reverse_proxy backend_prod:8000
    }
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}
