# Rung — Caddy dev config
# /api/* -> backend, everything else -> Vite dev server (with HMR/WS pass-through)

:80 {
    @api path /api/* /healthz /readyz /go/*
    reverse_proxy @api backend:8000

    reverse_proxy * frontend:5173 {
        header_up Host {host}
        transport http {
            keepalive 30s
        }
    }
}
